"""fast-feature-transform C++ core"""

from collections.abc import Sequence

class EngineError(RuntimeError): ...

class FittedPipeline:
    def transform_batch(self, sources: Sequence[str], output_dir: str) -> list[str]: ...
    def transform_memmap(self, sources: Sequence[str], output_dir: str) -> str: ...
    def transform_row(self, record: dict) -> dict: ...
    def stage_state(self, stage: str) -> str: ...
    def vocab_size(self, stage: str, column: str) -> int: ...
    def manifest_json(self) -> str: ...
    def stages_json(self) -> str: ...
    def stages_state(self) -> str: ...
    def save(self, dir: str) -> None: ...
    @staticmethod
    def load(dir: str, threads: int = 0) -> FittedPipeline: ...
    @staticmethod
    def load_json(manifest: str, threads: int = 0) -> FittedPipeline: ...

class Engine:
    def __init__(self, threads: int = 0, temp_dir: str = "") -> None: ...
    def fit(self, plan_json: str, sources: Sequence[str]) -> FittedPipeline: ...

def library_version() -> str: ...
def parquet_to_memmap(sources: Sequence[str], output_dir: str, threads: int = 0) -> str: ...
